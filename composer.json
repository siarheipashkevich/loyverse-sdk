{
    "name": "pashkevich/loyverse-sdk",
    "description": "A simple to use PHP SDK for the Loyverse API",
    "keywords": [
        "loyverse",
        "loyverse-api",
        "loyverse-sdk",
        "loyverse-php"
    ],
    "homepage": "https://github.com/siarheipashkevich/loyverse-sdk",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Sergey Pashkevich",
            "email": "siarheipashkevich@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Pashkevich\\Loyverse\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pashkevich\\Loyverse\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "format-test": "vendor/bin/pint --test"
    },
    "config": {
        "sort-packages": true
    }
}
