{
    "name": "pashkevich/loyverse-sdk",
    "description": "A simple to use PHP SDK for the Loyverse API",
    "keywords": [
        "loyverse",
        "loyverse-api",
        "loyverse-sdk",
        "loyverse-php"
    ],
    "homepage": "https://github.com/siarheipashkevich/loyverse-sdk",
    "license": "MIT",
    "type": "library",
    "support": {
        "issues": "https://github.com/siarheipashkevich/loyverse-sdk/issues",
        "source": "https://github.com/siarheipashkevich/loyverse-sdk"
    },
    "authors": [
        {
            "name": "Sergey Pashkevich",
            "email": "siarheipashkevich@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^8.0"
    },
    "require-dev": {
        "infection/infection": "^0.35",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Pashkevich\\Loyverse\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pashkevich\\Loyverse\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-integration": "vendor/bin/phpunit -c phpunit-integration.xml",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "test-coverage-check": "vendor/bin/phpunit --coverage-clover build/coverage.xml && php scripts/coverage-check.php build/coverage.xml 80",
        "analyse": "vendor/bin/phpstan analyse",
        "analyse-tests": "vendor/bin/phpstan analyse -c phpstan-tests.neon.dist",
        "infection": "php -d auto_prepend_file= vendor/bin/infection --threads=4 --min-msi=60 --min-covered-msi=70",
        "format": "vendor/bin/pint",
        "format-test": "vendor/bin/pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "4.x-dev"
        }
    }
}
